# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
DJANGO_SECRET_KEY=сгенерируйте: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=attendance.local,127.0.0.1
DJANGO_HTTPS=1
DJANGO_CSRF_TRUSTED=https://attendance.local
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=задайте пароль
POSTGRES_HOST=127.0.0.1
# ключ шифрования эталонов: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BIOMETRIC_KEY=
FACE_MODELS_DIR=/opt/attendance/models
FACE_DETECTOR=scrfd
FACE_ACCEPT=0.40
FACE_REVIEW=0.25
FACE_LIVENESS=0.60
